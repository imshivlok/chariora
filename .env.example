PORT=8787
# Set to 1 when deployed behind a proxy/load balancer (Railway, Render, Fly, nginx) so rate limiting sees real client IPs
# TRUST_PROXY=1

# --- AI analysis (optional: the app runs without it and skips the AI signal) ---
# Block 1: Google Gemini via its OpenAI-compatible endpoint (get a key in Google AI Studio)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-google-ai-studio-key
LLM_MODEL=your-gemini-flash-or-flash-lite-model-name

# Block 2: local Omniroute for development (comment out Block 1 and use this instead)
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=your-omniroute-key
# LLM_MODEL=your-omniroute-model-or-combo-name

# --- Optional providers (each is skipped gracefully when the key is missing) ---
SAFE_BROWSING_API_KEY=
YOUTUBE_API_KEY=
CHARITY_COMMISSION_API_KEY=
CHARITY_NAVIGATOR_API_KEY=
